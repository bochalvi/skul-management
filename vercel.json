{
    "builds": [{
        "src": "school_management/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
    }],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "school_management/wsgi.py"
        }
    ]
}
{
  "scripts": {
    "vercel-build": "sed -i '1s/^\\xEF\\xBB\\xBF//' requirements.txt && your_original_build_command"
  }
}
